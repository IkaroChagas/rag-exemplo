# Provedor do LLM: "claude" ou "gemini" (se vazio, usa Gemini quando GEMINI_API_KEY existir)
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
CLAUDE_MODEL=claude-sonnet-5-5
GEMINI_MODEL=gemini-3.5-flash-lite
# Cidade/região da agência (opcional): melhora respostas gerais de turismo
DESTINO=
# Busca: "vector" (padrão) ou "hybrid" (significado + palavras-chave)
SEARCH_MODE=vector
# Modelo de embeddings (ao trocar, rode python ingest.py de novo)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
